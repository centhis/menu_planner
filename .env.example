# Copy this file to .env and fill local secrets there.
# Never commit real API keys or Telegram tokens.

# Hermes
HERMES_USE_CODEX_AUTH=1

# Dashboard
# The dashboard is exposed on HERMES_DASHBOARD_PORT and protected by Hermes'
# bundled dashboard_auth/basic provider, enabled through config/hermes-managed-config.yaml.
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119

# Required when HERMES_DASHBOARD_HOST is non-loopback and HERMES_DASHBOARD=1.
# Keep PASSWORD and SECRET real values only in local .env.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# Hermes requires at least 16 bytes. A shorter value prevents
# dashboard_auth/basic from registering and causes:
# "Refusing to bind dashboard to 0.0.0.0".
# Use a long random string.
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# Codex-backed OpenAI access
# When HERMES_USE_CODEX_AUTH=1, container startup checks
# `hermes auth status openai-codex`. If login is missing, Hermes prints the
# OpenAI device-code URL and user code via `hermes auth add openai-codex`.
# Do not put CODEX_ACCESS_TOKEN or auth.json contents here.

# Optional model provider credentials.
# Stage 0 should prefer Codex-backed OpenAI access, but later stages may switch
# providers by changing Hermes configuration and supplying the matching secret.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Telegram Gateway
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# Optional: for cron/notification delivery. For DMs this is your Telegram user ID.
# You can also set it later from Telegram with /set-home.
TELEGRAM_HOME_CHANNEL=
# Optional: proxy URL for Telegram API access, for example http://, https://, or socks5://.
TELEGRAM_PROXY=
